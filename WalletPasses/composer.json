{
    "name": "wallet-passes/espocrm-extension",
    "description": "EspoCRM extension: Apple Wallet & Google Wallet passes.",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.1",
        "ext-openssl": "*",
        "ext-zip": "*",
        "ext-curl": "*",
        "ext-gd": "*",
        "ext-json": "*",
        "pkpass/pkpass": "^2.3",
        "bacon/bacon-qr-code": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "squizlabs/php_codesniffer": "^3.10"
    },
    "autoload": {
        "psr-4": {
            "Espo\\Modules\\WalletPasses\\": "src/files/custom/Espo/Modules/WalletPasses/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "WalletPasses\\Tests\\": "tests/"
        }
    },
    "config": {
        "platform": {"php": "8.1.0"},
        "sort-packages": true,
        "optimize-autoloader": true
    }
}
